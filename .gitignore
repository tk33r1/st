# Node.js
node_modules/

# Wrangler
.wrangler/
.dev.vars

# ローカル実行用の環境変数（APIキー類）
.env
.env.*
!.env.example

# Android APK (distributed via GitHub Releases)
*.apk

# Debug captures (DevTools DOM dumps, CDP/browser logs)
dom.txt
err.txt
*.log

# Python cache
__pycache__/
*.pyc

# Codex に添付した画像の一時置き場（サイトの公開範囲に入るので、コミットしない）
.codex-remote-attachments/

# エディタの手元設定（1人で管理しているので共有しない。リポジトリ直下は公開範囲にも入る）
.vscode/

# Claude Code の手元の許可リスト（手元のパスや叩いたコマンドが残る。共有する設定は .claude/settings.json）
.claude/settings.local.json
