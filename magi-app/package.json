{
  "name": "magi-app",
  "version": "6.5.1",
  "private": true,
  "description": "MAGI mobile — Multi-Agent Generative Intelligence client (PWA + Capacitor)",
  "scripts": {
    "postinstall": "node scripts/patch-speech.cjs",
    "serve": "npx --yes serve www -l 5173",
    "icons": "node scripts/generate-icons.cjs",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "sync": "npx cap sync android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@mozilla/readability": "0.6.0"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3"
  }
}
