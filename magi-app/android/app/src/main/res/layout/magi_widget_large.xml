<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/magi_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold" android:textColor="#4ade80" android:text="@string/widget_masked" />
        <TextView android:id="@+id/widget_verdict" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:singleLine="true" android:textSize="11sp" android:textColor="#4ade80" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:gravity="top" android:maxLines="3" android:ellipsize="end" android:textSize="13sp" android:textColor="#d6f7df" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <Button android:id="@+id/widget_new" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp" android:singleLine="true" android:textAllCaps="false" android:textSize="11sp" android:textColor="#4ade80" android:background="@drawable/magi_widget_button" android:text="@string/widget_new_short" android:contentDescription="@string/widget_new" />
        <ImageButton android:id="@+id/widget_voice" android:layout_width="38dp" android:layout_height="match_parent" android:layout_marginHorizontal="5dp" android:padding="6dp" android:background="@drawable/magi_widget_button" android:src="@drawable/magi_widget_mic" android:contentDescription="@string/widget_voice" />
        <Button android:id="@+id/widget_resume" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp" android:singleLine="true" android:textAllCaps="false" android:textSize="11sp" android:textColor="#4ade80" android:background="@drawable/magi_widget_button" android:text="@string/widget_resume_short" android:contentDescription="@string/widget_resume" />
    </LinearLayout>
</LinearLayout>
