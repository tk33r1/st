<!-- 幅2マス・高さ1マスの形。4つの入口をアイコンだけで並べる。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/magi_widget_background">
    <ImageButton android:id="@+id/widget_chat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="center" android:background="@drawable/magi_widget_button" android:src="@drawable/magi_widget_logo" android:contentDescription="@string/widget_chat" />
    <ImageButton android:id="@+id/widget_camera" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:scaleType="center" android:background="@drawable/magi_widget_button" android:src="@drawable/magi_widget_camera" android:contentDescription="@string/widget_camera" />
    <ImageButton android:id="@+id/widget_album" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:scaleType="center" android:background="@drawable/magi_widget_button" android:src="@drawable/magi_widget_album" android:contentDescription="@string/widget_album" />
    <ImageButton android:id="@+id/widget_voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:scaleType="center" android:background="@drawable/magi_widget_button" android:src="@drawable/magi_widget_mic" android:contentDescription="@string/widget_voice" />
</LinearLayout>
